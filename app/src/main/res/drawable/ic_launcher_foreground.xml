<?xml version="1.0" encoding="utf-8"?>
<!-- A shopping list inside a circular arrow: the list comes round again, item by item, at the household's own pace.
     Two rows are ticked; the amber row is the one about to run out ("כנראה נגמר בקרוב").
     The ticks sit on the right, as on a Hebrew list. Everything stays inside the 66dp safe zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The cycle: an open ring with an arrowhead (clockwise) -->
    <path
        android:pathData="M68.3,33.5 A25,25 0 1,1 45.4,30.5"
        android:strokeColor="#FFFFF8E7"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M52.0,28.1 L46.7,37.0 L42.3,24.7 Z"
        android:fillColor="#FFFFF8E7"
        android:strokeColor="#FFFFF8E7"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round" />

    <!-- Row 1: ticked -->
    <path android:fillColor="#FFFFF8E7" android:pathData="M61,45 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
    <path
        android:pathData="M63.1,45.1 L64.5,46.5 L67,43.7"
        android:strokeColor="#FF2E7D32"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path android:pathData="M40,45 H58" android:strokeColor="#E6FFF8E7" android:strokeWidth="3.4" android:strokeLineCap="round" />

    <!-- Row 2: ticked -->
    <path android:fillColor="#FFFFF8E7" android:pathData="M61,55 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
    <path
        android:pathData="M63.1,55.1 L64.5,56.5 L67,53.7"
        android:strokeColor="#FF2E7D32"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path android:pathData="M43,55 H58" android:strokeColor="#E6FFF8E7" android:strokeWidth="3.4" android:strokeLineCap="round" />

    <!-- Row 3: running out soon (amber) -->
    <path
        android:fillColor="#FFFFB300"
        android:strokeColor="#FFFFF8E7"
        android:strokeWidth="1.2"
        android:pathData="M61,65 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
    <path android:pathData="M46,65 H58" android:strokeColor="#8CFFF8E7" android:strokeWidth="3.4" android:strokeLineCap="round" />
</vector>
