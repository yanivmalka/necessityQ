<?xml version="1.0" encoding="utf-8"?>
<!-- One layer of the basket picture on the opening screen (StartupScreen): ground shadow, handle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ground shadow -->
    <group android:pivotX="54" android:pivotY="81" android:scaleY="0.1875">
        <path android:pathData="M30,81 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="54" android:centerY="81" android:gradientRadius="24">
                    <item android:offset="0" android:color="#59000000" />
                    <item android:offset="1" android:color="#00000000" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Handle -->
    <path
        android:pathData="M38,50 Q38,30 54,30 Q70,30 70,50"
        android:strokeColor="#FFE9D3A4"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <group android:translateX="-0.6" android:translateY="-0.8">
        <path
            android:pathData="M38,50 Q38,30 54,30 Q70,30 70,50"
            android:strokeColor="#E6FFF8E7"
            android:strokeWidth="1.6"
            android:strokeLineCap="round" />
    </group>
</vector>
