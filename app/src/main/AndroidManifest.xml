    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- voice messages in item conversations -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- צ'אט פוד: a tag or quote vibrates too -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".NecessityApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NecessityQ">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- joining a household by link: necessityq://join?code=… (the shared web page opens it) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="necessityq" android:host="join" />
            </intent-filter>
        </activity>

        <!-- The launcher entries, one per app icon the user can choose (AppIcons): exactly one is enabled at a time.
             The first is the default; the app switches between them from "מראה". -->
