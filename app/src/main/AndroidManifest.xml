<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- voice messages in item conversations -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- צ'אט פוד: a tag or quote vibrates too -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".NecessityApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NecessityQ">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- The launcher entries, one per app icon the user can choose (AppIcons): exactly one is enabled at a time.
             The first is the default; the app switches between them from "מראה". -->
        <activity-alias
            android:name=".IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconListBadge"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_list_badge"
            android:roundIcon="@mipmap/ic_launcher_list_badge"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCartCycle"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cart_cycle"
            android:roundIcon="@mipmap/ic_launcher_cart_cycle"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCartList"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cart_list"
            android:roundIcon="@mipmap/ic_launcher_cart_list"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBasket"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_basket"
            android:roundIcon="@mipmap/ic_launcher_basket"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- צ'אט פוד: pushes of tags and quotes, also while the app is closed -->
        <service
            android:name=".data.firebase.ChatPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- installs Google's barcode-scanner module together with the app (no camera permission needed) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- hands the downloaded update APK to the system installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
