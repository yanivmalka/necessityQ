rules_version = '2';

// Per-branch price snapshots (prices/{branchId}.json.gz) are written by the ingestion functions
// and readable by any signed-in user. Nothing else lives in this bucket.
service firebase.storage {
  match /b/{bucket}/o {
    match /prices/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
