rules_version = '2';

// Per-branch price snapshots (prices/{branchId}.json.gz) are written by the ingestion functions
// and readable by any signed-in user, as is the nutrition snapshot.
service firebase.storage {
  match /b/{bucket}/o {
    match /prices/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Promotions per branch (promos/{branchId}.json.gz), refreshed every 30 minutes by the functions.
    match /promos/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Tzameret nutrition snapshot (nutrition/tzameret.json.gz), written by the functions.
    match /nutrition/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
