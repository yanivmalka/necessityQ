rules_version = '2';

// necessityQ — only members of a household can read or write its data.
// The owner (ownerId; for older households the first member) manages participants.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function household(hid) { return get(/databases/$(database)/documents/households/$(hid)).data; }
    function isMember(hid) { return signedIn() && uid() in household(hid).members; }
    function isOwner(hid) {
      return isMember(hid) && uid() == household(hid).get('ownerId', household(hid).members[0]);
    }

    // Each user can only read/write their own profile and household pointer.
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // One-time invitations. The token (24 random characters) is the key, so a signed-in user may get one by its
    // token but never list them. Any member creates one (valid up to 7 days); whoever joins uses it up by setting
    // usedBy to themselves, once; the creator or the owner may revoke it. The old 6-character join codes are gone.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == uid()
        && request.resource.data.keys().hasOnly(['householdId', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd') + duration.value(1, 'h');
      allow update: if signedIn()
        && !('usedBy' in resource.data)
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == uid()
        && request.resource.data.usedAt == request.time;
      allow delete: if signedIn() && (resource.data.createdBy == uid() || isOwner(resource.data.householdId));
    }

    // Joining a household: the batch must also mark an unused, unexpired invitation to this household as used by
    // the joiner. The invitation is named by the user's own `joinToken`, written in the same batch.
    function joinsByInvite(hid) {
      let t = getAfter(/databases/$(database)/documents/users/$(uid())).data.get('joinToken', '');
      let before = get(/databases/$(database)/documents/invites/$(t)).data;
      let after = getAfter(/databases/$(database)/documents/invites/$(t)).data;
      return t != ''
        && before.householdId == hid
        && !('usedBy' in before)
        && before.expiresAt > request.time
        && after.usedBy == uid();
    }

    match /households/{hid} {
      allow read: if isMember(hid);
      // creator must be the only initial member (and the owner)
      allow create: if signedIn() && request.resource.data.members == [uid()]
        && request.resource.data.ownerId == uid();
      allow update:
        // owner: rename, remove participants, hand over ownership
        if isOwner(hid)
        // any member may remove only themselves; ownerId must stay untouched (an owner who leaves
        // hands ownership over through the isOwner clause above)
        || (isMember(hid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([uid()].toSet()))
        // anyone signed in may add only themselves, and only by using up a one-time invitation
        || (signedIn()
            && joinsByInvite(hid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [uid()].toSet()
            && resource.data.members.toSet().difference(request.resource.data.members.toSet()).size() == 0);

      // participants' own profile cards: each writes only their own; the owner may remove any
      match /members/{memberId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid) && uid() == memberId;
        allow delete: if uid() == memberId || isOwner(hid);
      }

      match /stores/{id} { allow read, write: if isMember(hid); }
      match /itemMeta/{id} { allow read, write: if isMember(hid); }
      match /settings/{id} { allow read, write: if isMember(hid); }
      // item conversations: members write as themselves; only the author edits (or marks deleted); any
      // member may archive (the shopping event ended), delete (clearing a conversation), and set or
      // remove their own emoji reaction — never somebody else's
      match /messages/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.authorId == uid();
        allow update: if isMember(hid) && (resource.data.authorId == uid()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivedAt'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([uid()])));
        allow delete: if isMember(hid);
      }

      // pictures / recordings of messages: written once by their author, readable by members
      match /media/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.by == uid();
        allow update: if false;
        allow delete: if isMember(hid);
      }

      // live "typing…" marks: each member writes only their own
      match /typing/{typerId} {
        allow read: if isMember(hid);
        allow write: if isMember(hid) && uid() == typerId;
      }

      // read receipts: each member writes only their own
      match /reads/{readerId} {
        allow read: if isMember(hid);
        allow write: if isMember(hid) && uid() == readerId;
      }

      match /lines/{id} { allow read, write: if isMember(hid); }
      match /purchases/{id} { allow read, write: if isMember(hid); }
      match /suppressions/{id} { allow read, write: if isMember(hid); }
      // daily count of model questions (quick-add readings, first-list estimates): server only, so it can't be reset from a phone
      match /usage/{id} { allow read, write: if false; }
    }

    // Public price-transparency data, written only by the ingestion functions (admin SDK).
    match /prices/{doc} { allow read: if signedIn(); allow write: if false; }
    match /priceBranches/{branchId} { allow read: if signedIn(); allow write: if false; }
    match /promoBranches/{branchId} { allow read: if signedIn(); allow write: if false; }
    match /nutrition/{doc} { allow read: if signedIn(); allow write: if false; }
    // config/prices is edited by the admin in the Firebase console; geocodeCache is server-only.
    match /config/{doc} { allow read, write: if false; }
    match /geocodeCache/{key} { allow read, write: if false; }
    // readings of quick-add text (functions/src/interpret.ts): server only
    match /interpretCache/{key} { allow read, write: if false; }
    // first-list estimates by household makeup (functions/src/baseline.ts): server only
    match /baselineCache/{key} { allow read, write: if false; }
    match /starterCache/{key} { allow read, write: if false; }
  }
}
